  m_Script: {fileID: 11500000, guid: 6d4fbcce89040b54c9d99adbac5660a5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  questionsTopik1:
  - questionText: "1. Lengkapi urutan jalur pernapasan berikut: Hidung \u2192 laring
      \u2192 ........ \u2192 bronkus \u2192 paru-paru "
    options:
    - a. Trakea
    - b. Kerongkongan
    - c. Usus
    - d. Diafragma
    correctAnswerIndex: 0
  - questionText: '2. Organ penyaring udara:'
    options:
    - a. Faring
    - b. Trakea
    - c. Hidung
    - d. Bronkus
    correctAnswerIndex: 2
  - questionText: 3. Pertukaran gas terjadi di...
    options:
    - a. Trakea
    - b. Bronkus
    - c. Paru-paru
    - d. Alveolus
    correctAnswerIndex: 3
  - questionText: '4. Otot bantu napas:'
    options:
    - a. Jantung
    - b. Diafragma
    - c. Trakea
    - d. Silia
    correctAnswerIndex: 1
  - questionText: 5. Silia berfungsi untuk...
    options:
    - a. Bersuara
    - b. Serap oksigen
    - 'c. Saring kotoran '
    - d. Hancurkan CO2
    correctAnswerIndex: 2
  - questionText: '6. Organ penghasil suara:'
    options:
    - a. Paru-paru
    - b. Faring
    - 'c. Laring '
    - d. Alveolus
    correctAnswerIndex: 2
  - questionText: 7. Tarik napas = rongga dada...
    options:
    - a. Mengecil
    - b. Mengembang
    - c. Mengempis
    - d. Mengerut
    correctAnswerIndex: 1
  - questionText: '8. Fungsi utama sistem pernapasan:'
    options:
    - a. Alirkan darah
    - b. Cerna makanan
    - "c. Oksigen masuk \u2013 CO2 keluar"
    - d. Simpan makanan
    correctAnswerIndex: 2
  - questionText: '9. Bahaya merokok bagi paru:'
    options:
    - a. Daya tahan naik
    - b. Alveolus rusak
    - c. Oksigen naik
    - d. Bronkus kuat
    correctAnswerIndex: 1
  - questionText: 10. Emfisema disebabkan oleh...
    options:
    - a. Virus
    - b. Otot rusak
    - ' c. Alveolus rusak'
    - d. Kurang oksigen
    correctAnswerIndex: 2
  questionsTopik2:
  - questionText: 1. Di mana pencernaan kimiawi dan mekanik pertama kali terjadi?
    options:
    - a. Mulut
    - b. Lambung
    - c. Usus halus
    - d. Esofagus
    correctAnswerIndex: 0
  - questionText: 2. Enzim amilase menguraikan...
    options:
    - a. Lemak
    - b. Protein
    - c. Karbohidrat
    - d. Vitamin
    correctAnswerIndex: 2
  - questionText: 3. Saluran dari mulut ke lambung disebut...
    options:
    - a. Faring
    - b. Laring
    - c. Esofagus
    - d. Rektum
    correctAnswerIndex: 2
  - questionText: 4. Proses mendorong makanan disebut...
    options:
    - a. Emulsifikasi
    - b. Respirasi
    - c. Peristaltik
    - d. Kontraksi
    correctAnswerIndex: 2
  - questionText: 5. Pepsin berfungsi mencerna...
    options:
    - a. Lemak
    - b. Protein
    - c. Karbohidrat
    - d. Bakteri
    correctAnswerIndex: 1
  - questionText: 6. Nutrisi diserap di...
    options:
    - a. Lambung
    - b. Usus besar
    - c. Usus halus
    - d. Rektum
    correctAnswerIndex: 2
  - questionText: 7. Fungsi hati adalah...
    options:
    - a. Mencerna protein
    - b. Membuat asam
    - c. Menghasilkan empedu
    - d. Menyerap air
    correctAnswerIndex: 2
  - questionText: 8. Lipase mencerna...
    options:
    - a. Karbohidrat
    - b. Protein
    - c. Lemak
    - d. Serat
    correctAnswerIndex: 2
  - questionText: 9. Feses dibentuk di...
    options:
    - a. Lambung
    - b. Usus halus
    - c. Usus besar
    - d. Esofagus
    correctAnswerIndex: 2
  - questionText: 10. Kurang serat menyebabkan...
    options:
    - a. Sariawan
    - b. Sembelit
    - c. Gangguan jantung
    - d. Kurang oksigen
    correctAnswerIndex: 1
